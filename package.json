    "@mui/x-tree-view": "^7.29.10",
    "@organigram/js": "workspace:^",
    "@organigram/react": "workspace:^",
    "@types/lodash": "^4.17.21",
    "@types/react": "18.3.3",
    "@types/react-dom": "^18.3.7",
    "env-cmd": "^10.1.0",
    "i18next": "^23.16.8",
    "lodash": "^4.17.21",
    "markdown-link-check": "^3.14.2",
    "next": "^16.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-flow-renderer": "^10.3.17",
    "remark-gfm": "^4.0.1",
    "stripe": "^16.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "viem": "2.55.2"
