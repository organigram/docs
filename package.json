    "@mui/x-tree-view": "^7.29.10",
    "@organigram/js": "workspace:^",
    "@organigram/react": "workspace:^",
    "i18next": "^23.16.8",
    "lodash": "^4.17.21",
    "next": "^16.2.7",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "@code-hike/mdx": "^0.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@microsoft/api-documenter": "^7.25.9",
